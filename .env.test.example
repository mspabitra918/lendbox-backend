# Test database configuration. Copy to .env.test. Point at a DISPOSABLE database:
# the e2e suite drops and recreates every table in it.
NODE_ENV=test
PORT=0
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001
TRUST_PROXY=0
SWAGGER_ENABLED=false
LOG_LEVEL=error

DB_HOST=localhost
DB_PORT=5432
DB_NAME=lendbox_test
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

FIELD_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
FINGERPRINT_SECRET=test-fingerprint-secret-at-least-32-characters
JWT_ACCESS_SECRET=test-jwt-secret-that-is-at-least-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
AUTH_COOKIE_SECURE=false
BCRYPT_ROUNDS=4
LOGIN_RATE_LIMIT=100
RATE_LIMIT=1000
STRICT_RATE_LIMIT=1000

MAIL_TRANSPORT=json
SMTP_FROM="Lendbox Test <no-reply@example.test>"
ADMIN_NOTIFICATION_EMAIL=admin@example.test
SUPPORT_EMAIL=support@example.test
EMAIL_WORKER_ENABLED=false

ESIGN_PROVIDER=internal
SIGNING_LINK_EXPIRES_HOURS=72
DOCUSIGN_WEBHOOK_SECRET=test-docusign-connect-hmac-secret
