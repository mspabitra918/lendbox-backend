{
  "name": "lendbox-backend",
  "version": "1.0.0",
  "description": "Lendbox loan application management API (NestJS + PostgreSQL + Sequelize)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed:admin": "sequelize-cli db:seed --seed 20261017000100-initial-admin.js",
    "admin:create": "node dist/cli/create-admin.js",
    "admin:create:dev": "ts-node -r tsconfig-paths/register src/cli/create-admin.ts",
    "test": "jest --config jest.config.js --selectProjects unit",
    "test:cov": "jest --config jest.config.js --coverage"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.6",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/sequelize": "11.0.1",
    "@nestjs/swagger": "11.2.0",
    "@nestjs/throttler": "6.4.0",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "dotenv": "16.6.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "nodemailer": "7.0.6",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.16.3",
    "pg-hstore": "2.3.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sequelize": "6.37.7",
    "sequelize-cli": "6.6.3",
    "sequelize-typescript": "2.1.6"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/testing": "11.1.6",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.19.17",
    "@types/nodemailer": "7.0.1",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "6.0.3",
    "@types/validator": "13.15.3",
    "jest": "30.1.3",
    "supertest": "7.1.4",
    "ts-jest": "29.4.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  }
}
