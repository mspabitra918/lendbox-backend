# ─────────────────────────────────────────────────────────────────────────────
# Lendbox backend configuration. Copy to .env and fill in. NEVER commit .env.
# Values below are placeholders only.
# Generate secrets with:  openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
# Public site (loan form, signing page) and the admin dashboard origins.
# Both are allowed by CORS. Comma-separate multiple origins if needed.
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3000
# Path on ADMIN_FRONTEND_URL where an application detail page lives (used in admin emails).
ADMIN_APPLICATION_PATH=/admin/applications
# Path on FRONTEND_URL that renders the agreement signing page; the token is appended as ?token=
SIGNING_PAGE_PATH=/borrower/agreement/sign
# Number of reverse proxies in front of the app (1 behind Nginx). Needed for correct client IPs.
TRUST_PROXY=1
# Max JSON body size
BODY_LIMIT=100kb
SWAGGER_ENABLED=true
LOG_LEVEL=log

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lendbox
DB_USER=lendbox
DB_PASSWORD=change-me
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10

# Field-level encryption for SSN, licence, bank numbers (AES-256-GCM).
# Must be 32 bytes, base64-encoded:  openssl rand -base64 32
# Losing this key makes stored sensitive fields unrecoverable. Back it up separately from DB backups.
FIELD_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
# HMAC key for duplicate-submission fingerprints (min 32 chars).
FINGERPRINT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
# Window in which an identical submission is treated as a duplicate.
DUPLICATE_SUBMISSION_WINDOW_MINUTES=15

# Admin auth
JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS
JWT_ACCESS_EXPIRES_IN=30m
JWT_ISSUER=lendbox-api
JWT_AUDIENCE=lendbox-admin
AUTH_COOKIE_NAME=lendbox_admin
# Set to true in production (requires HTTPS). SameSite=strict is always used.
AUTH_COOKIE_SECURE=false
BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT=5
LOGIN_RATE_TTL_SECONDS=60

# Global rate limit (per IP)
RATE_LIMIT=100
RATE_LIMIT_TTL_SECONDS=60
# Per-IP per-minute limit for applicant status lookup and agreement signing
STRICT_RATE_LIMIT=10

# Initial admin seeder (used only by `npm run db:seed:admin`; remove afterwards)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=

# Email (SMTP via Nodemailer)
# MAIL_TRANSPORT=smtp sends real mail. MAIL_TRANSPORT=json renders but does not send (dev/test only).
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Lendbox <no-reply@example.com>"
ADMIN_NOTIFICATION_EMAIL=admin@example.com
SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE=+1 (555) 010-0000
# Background delivery worker
EMAIL_WORKER_ENABLED=true
EMAIL_WORKER_INTERVAL_MS=15000
EMAIL_MAX_ATTEMPTS=5

# Loan agreement / e-signature
# ESIGN_PROVIDER=internal   built-in token + identity-check signing flow (requires legal review, see README)
# ESIGN_PROVIDER=docusign   DocuSign eSignature (embedded signing + Connect webhooks)
ESIGN_PROVIDER=internal
SIGNING_LINK_EXPIRES_HOURS=72
SIGNING_MAX_VERIFICATION_ATTEMPTS=5
AGREEMENT_TEMPLATE_VERSION=v0-draft

# DocuSign (required only when ESIGN_PROVIDER=docusign)
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
DOCUSIGN_OAUTH_BASE=account-d.docusign.com
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
# RSA private key for JWT grant, base64-encoded PEM
DOCUSIGN_PRIVATE_KEY_BASE64=
# Connect HMAC key (Connect → HMAC Signature in DocuSign admin)
DOCUSIGN_WEBHOOK_SECRET=
# Where DocuSign returns the signer after embedded signing
DOCUSIGN_RETURN_URL=http://localhost:3000/borrower/agreement/complete
